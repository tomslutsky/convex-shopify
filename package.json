{
  "name": "@convex-dev/shopify",
  "version": "0.2.0",
  "description": "A Convex component and TypeScript facade for Shopify integrations.",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "workspaces": [
    "template",
    "packages/create-convex-shopify"
  ],
  "files": [
    "dist",
    "README.md",
    "CONTRACT.md",
    "ARCHITECTURE.md",
    "ENVIRONMENT.md",
    "SECURITY.md",
    "VERSIONING.md"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./partner": {
      "types": "./dist/partner.d.ts",
      "default": "./dist/partner.js"
    },
    "./pagination": {
      "types": "./dist/pagination.d.ts",
      "default": "./dist/pagination.js"
    },
    "./test": {
      "types": "./dist/test.d.ts",
      "default": "./dist/test.js"
    },
    "./_generated/component.js": {
      "types": "./dist/component/_generated/component.d.ts",
      "default": "./dist/component/_generated/component.js"
    },
    "./convex.config": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    },
    "./convex.config.js": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    }
  },
  "bin": {
    "convex-shopify": "./dist/codegen/cli.js"
  },
  "scripts": {
    "build:codegen": "node ./scripts/component-codegen.mjs",
    "build:package": "node ./scripts/build-package.mjs",
    "build": "npm run build:codegen && npm run build:package",
    "typecheck": "tsc --project ./tsconfig.json",
    "typecheck:example": "tsc --project ./example/tsconfig.json",
    "verify:component": "npm run build && npm run typecheck && npm run typecheck:example && npm test && npm run pack:check",
    "verify": "npm run verify:component && npm run verify:initializer && npm run build --workspace shopify-convex-template && npm run test --workspace shopify-convex-template",
    "test": "vitest run --config ./vitest.config.ts",
    "test:all": "npm test && npm run test --workspace shopify-convex-template",
    "verify:initializer": "npm run typecheck --workspace create-convex-shopify && npm run test --workspace create-convex-shopify && npm run build --workspace create-convex-shopify && npm run pack:check --workspace create-convex-shopify",
    "pack:check": "node ./scripts/check-packed-package.mjs"
  },
  "peerDependencies": {
    "@graphql-typed-document-node/core": "^3.2.0",
    "convex": "^1.43.0",
    "graphql": ">=16.0.0 <18.0.0"
  },
  "dependencies": {
    "@convex-dev/batch-worker": "^0.2.0",
    "@convex-dev/workpool": "^0.4.9",
    "convex-helpers": "^0.1.123",
    "jose": "^6.2.8"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "1.2.4",
    "lightningcss-linux-x64-gnu": "1.33.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@types/node": "^26.1.2",
    "convex": "^1.43.0",
    "convex-test": "^0.0.55",
    "graphql": "^16.14.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.18"
  }
}
