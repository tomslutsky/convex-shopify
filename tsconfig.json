{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "./client.ts",
    "./pagination.ts",
    "./partner.ts",
    "./register.ts",
    "./test.ts",
    "./vitest.config.ts",
    "./**/*.test.ts",
    "./codegen/**/*.ts",
    "./component/**/*.ts"
  ],
  "exclude": ["./dist"]
}
