{
  "name": "shopify-convex-template",
  "version": "0.2.2",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "convex dev --start 'vite dev'",
    "setup": "node scripts/setup.mjs",
    "build": "npm run typecheck && vite build",
    "start": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "shopify:codegen": "graphql-codegen --config .graphqlrc.ts",
    "auth:keys": "node scripts/generate-auth-keys.mjs",
    "setup:check": "node scripts/check-setup.mjs",
    "config:sync": "node scripts/sync-shopify-config.mjs development",
    "config:check": "node scripts/check-shopify-config.mjs"
  },
  "dependencies": {
    "@convex-dev/react-query": "^0.1.0",
    "@convex-dev/shopify": "file:..",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@shopify/app-bridge-react": "^4.2.12",
    "@tanstack/react-query": "^5.99.0",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-router-with-query": "^1.130.17",
    "@tanstack/react-start": "^1.168.35",
    "convex": "^1.43.0",
    "graphql": "^16.14.2",
    "jose": "^6.2.8",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "^2.0.0",
    "@convex-dev/workpool": "^0.4.9",
    "@edge-runtime/vm": "^5.0.0",
    "@graphql-codegen/cli": "^6.3.1",
    "@shopify/api-codegen-preset": "^2.0.1",
    "@shopify/app-bridge-types": "^0.7.2",
    "@shopify/cli": "^4.6.0",
    "@shopify/polaris-types": "^1.0.7",
    "@tanstack/eslint-config": "^0.4.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "convex-test": "^0.0.55",
    "graphql-config": "^5.1.6",
    "smol-toml": "^1.8.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.18"
  }
}
