{
  "include": ["**/*.ts", "**/*.tsx", ".graphqlrc.ts"],
  "exclude": ["node_modules", "convex/_generated"],
  "compilerOptions": {
    "target": "ES2022", "jsx": "react-jsx", "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": ["vite/client", "@shopify/app-bridge-types", "@shopify/polaris-types"],
    "moduleResolution": "bundler", "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true, "noEmit": true, "skipLibCheck": true,
    "strict": true, "noUnusedLocals": true, "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true, "noUncheckedSideEffectImports": true,
    "paths": { "~/*": ["./src/*"] }, "esModuleInterop": true,
    "isolatedModules": true, "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true
  }
}
